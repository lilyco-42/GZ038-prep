<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- ============ 标题栏 ============ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@color/colorPrimary"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="8dp"
        android:paddingRight="16dp">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="&#8249; "
            android:textColor="@color/white"
            android:textSize="22sp"
            android:textStyle="bold"
            android:padding="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="设置"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- ============ 设置列表 ============ -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 串口服务器IP -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingLeft="16dp"
                android:paddingRight="16dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="串口服务器IP"
                    android:textColor="#212121"
                    android:textSize="16sp" />

                <EditText
                    android:id="@+id/etIp"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1.5"
                    android:text="192.168.1.100"
                    android:textColor="#757575"
                    android:textSize="15sp"
                    android:gravity="end|center_vertical"
                    android:inputType="text"
                    android:background="@android:color/transparent"
                    android:singleLine="true" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" >"
                    android:textColor="#BDBDBD"
                    android:textSize="18sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#EEEEEE"
                android:layout_marginLeft="16dp" />

            <!-- UHF射频读写器 端口 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingLeft="16dp"
                android:paddingRight="16dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="UHF射频读写器 端口"
                    android:textColor="#212121"
                    android:textSize="16sp" />

                <EditText
                    android:id="@+id/etUhfPort"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1.5"
                    android:text="6001"
                    android:textColor="#757575"
                    android:textSize="15sp"
                    android:gravity="end|center_vertical"
                    android:inputType="number"
                    android:background="@android:color/transparent"
                    android:singleLine="true" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" >"
                    android:textColor="#BDBDBD"
                    android:textSize="18sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#EEEEEE"
                android:layout_marginLeft="16dp" />

            <!-- ADAM 端口 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingLeft="16dp"
                android:paddingRight="16dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="数据端口(8899)"
                    android:textColor="#212121"
                    android:textSize="16sp" />

                <EditText
                    android:id="@+id/etAdamPort"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1.5"
                    android:text="8899"
                    android:textColor="#757575"
                    android:textSize="15sp"
                    android:gravity="end|center_vertical"
                    android:inputType="number"
                    android:background="@android:color/transparent"
                    android:singleLine="true" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" >"
                    android:textColor="#BDBDBD"
                    android:textSize="18sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#EEEEEE"
                android:layout_marginLeft="16dp" />

            <!-- LED显示屏 端口 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingLeft="16dp"
                android:paddingRight="16dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="LED显示屏 端口"
                    android:textColor="#212121"
                    android:textSize="16sp" />

                <EditText
                    android:id="@+id/etLedPort"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1.5"
                    android:text="6003"
                    android:textColor="#757575"
                    android:textSize="15sp"
                    android:gravity="end|center_vertical"
                    android:inputType="number"
                    android:background="@android:color/transparent"
                    android:singleLine="true" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" >"
                    android:textColor="#BDBDBD"
                    android:textSize="18sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#EEEEEE"
                android:layout_marginLeft="16dp" />

            <!-- ZIGBEE 端口 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingLeft="16dp"
                android:paddingRight="16dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="控制端口(8888)"
                    android:textColor="#212121"
                    android:textSize="16sp" />

                <EditText
                    android:id="@+id/etZigbeePort"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1.5"
                    android:text="8888"
                    android:textColor="#757575"
                    android:textSize="15sp"
                    android:gravity="end|center_vertical"
                    android:inputType="number"
                    android:background="@android:color/transparent"
                    android:singleLine="true" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" >"
                    android:textColor="#BDBDBD"
                    android:textSize="18sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#EEEEEE"
                android:layout_marginLeft="16dp" />

            <!-- 三色灯（绿） -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingLeft="16dp"
                android:paddingRight="16dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="三色灯（绿）"
                    android:textColor="#212121"
                    android:textSize="16sp" />

                <EditText
                    android:id="@+id/etGreenDo"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1.5"
                    android:text="DO1"
                    android:textColor="#757575"
                    android:textSize="15sp"
                    android:gravity="end|center_vertical"
                    android:inputType="text"
                    android:background="@android:color/transparent"
                    android:singleLine="true" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" >"
                    android:textColor="#BDBDBD"
                    android:textSize="18sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#EEEEEE"
                android:layout_marginLeft="16dp" />

            <!-- 风扇 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingLeft="16dp"
                android:paddingRight="16dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="风扇"
                    android:textColor="#212121"
                    android:textSize="16sp" />

                <EditText
                    android:id="@+id/etFanDo"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1.5"
                    android:text="DO2"
                    android:textColor="#757575"
                    android:textSize="15sp"
                    android:gravity="end|center_vertical"
                    android:inputType="text"
                    android:background="@android:color/transparent"
                    android:singleLine="true" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" >"
                    android:textColor="#BDBDBD"
                    android:textSize="18sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- ============ 底部按钮 ============ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="12dp"
        android:background="#F5F5F5">

        <Button
            android:id="@+id/btnSave"
            android:layout_width="120dp"
            android:layout_height="40dp"
            android:layout_marginRight="12dp"
            android:background="@color/colorPrimary"
            android:text="保存"
            android:textColor="@color/white"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnCancel"
            android:layout_width="120dp"
            android:layout_height="40dp"
            android:background="#9E9E9E"
            android:text="取消"
            android:textColor="@color/white"
            android:textSize="16sp" />
    </LinearLayout>
</LinearLayout>
