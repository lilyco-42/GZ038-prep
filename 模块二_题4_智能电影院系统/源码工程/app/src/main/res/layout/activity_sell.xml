<?xml version="1.0" encoding="utf-8"?>
<!-- 售卖界面：读 RFID 激活电影票 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="智能电影院 · 售票台"
        android:textColor="@color/white"
        android:textSize="24sp"
        android:padding="12dp"
        android:gravity="center" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="电影票 RFID："
        android:textColor="@color/textDim"
        android:textSize="14sp"
        android:paddingTop="16dp" />

    <TextView
        android:id="@+id/tv_tag"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="--"
        android:textColor="@color/colorAccent"
        android:textSize="18sp"
        android:padding="8dp"
        android:background="#22FFFFFF" />

    <TextView
        android:id="@+id/tv_sell_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="请把电影票放在读写区"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:padding="8dp" />

    <Button
        android:id="@+id/btn_read_rfid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="读取 RFID" />

    <Button
        android:id="@+id/btn_activate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="激活电影票（售出）" />

    <Button
        android:id="@+id/btn_go_entrance"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="进入闸机 →" />

</LinearLayout>
